# Vitality BSS configuration. Copy to .env and edit. Never commit .env.
# Generate secrets with:  vitality-bss generate-secrets

# --- Runtime ---
# development | production | test
APP_ENV=development
APP_NAME=Vitality BSS
HOST=0.0.0.0
PORT=8001
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text  (PHI patterns are redacted either way)
LOG_FORMAT=json

# --- Persistence ---
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg2://vbss:CHANGE_ME@db:5432/vbss
# uploaded PDFs live in $DATA_DIR/uploads
DATA_DIR=./data
# run Alembic migrations on startup
AUTO_MIGRATE=true

# --- Auth ---
# >= 32 random chars; required in production
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# defaults to true when APP_ENV=production
# COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
# First admin, created only when the users table is empty:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Encryption at rest (Fernet). First key encrypts; all keys decrypt (rotation). ---
ENCRYPTION_KEYS=
REQUIRE_ENCRYPTION=false

# --- Upload limits ---
MAX_UPLOAD_MB=25
MAX_FILES_PER_REQUEST=20
MAX_PAGES_PER_DOCUMENT=500

# --- OCR (local tesseract + poppler; nothing leaves the host) ---
OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=25

# --- AI enrichment ---
# off  : deterministic rules only (default)
# mock : deterministic offline stand-in for an LLM (demos/tests)
# llm  : any OpenAI-compatible endpoint
AI_MODE=off
# e.g. http://localhost:11434/v1 (Ollama), https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=12000
# Remote LLM hosts receive document text (PHI). Only enable with a BAA / legal basis.
LLM_ALLOW_REMOTE_PHI=false

# --- Dedupe ---
# 0 disables near-duplicate detection
NEAR_DUPLICATE_THRESHOLD=0.97

# --- Demo ---
# loads synthetic documents; refused in production
SEED_DEMO_DATA=false
